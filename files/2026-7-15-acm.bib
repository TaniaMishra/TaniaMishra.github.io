@article{10.1145/3821572,
    author = {Zimmer, Michael and Mishra, Tania and Abrahamson, Riley},
    title = {Infrastructure of Ethics: How Publication Workflows Shape Ethical Expectations in Computational Research},
    year = {2026},
    issue_date = {September 2026},
    publisher = {Association for Computing Machinery},
    address = {New York, NY, USA},
    volume = {3},
    number = {3},
    url = {https://doi.org/10.1145/3821572},
    doi = {10.1145/3821572},
    abstract = {As computational research increasingly relies on large-scale, digitally generated data, concerns about research ethics have become more urgent. Yet beyond institutional oversight and informal disciplinary norms, comparatively little attention has been paid to the ethical infrastructures that shape researcher expectations within the publication process itself. This article presents an exploratory review of 191 computational journals and conferences to examine how ethics is communicated and operationalized through three components of publication infrastructure: public-facing author guidelines, manuscript submission workflows, and review procedures. We document the frequency, placement, and form of ethics-related prompts across these systems and analyze how they vary across subfields. Our findings reveal substantial inconsistency in how venues frame ethical responsibilities, with most offering only minimal or procedural disclosures and few integrating ethics meaningfully into review processes. We argue that these infrastructural gaps contribute to fragmented ethical expectations for researchers and limit opportunities for reflective practice. By mapping current practices, this work advances efforts to strengthen responsible computational research by illuminating how publication infrastructures—alongside institutional review boards and professional codes—play a critical role in shaping ethical reflection and accountability in computational research.},
    journal = {ACM J. Responsib. Comput.},
    month = jul,
    articleno = {12},
    numpages = {18},
    keywords = {Research ethics, publication ethics, pervasive data, editorial norms}
}